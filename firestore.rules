rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FUNÇÃO MESTRE: Identifica o Administrador por UID ou Email
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'skTsvEKxywUKcBKPHzG9h7WkK7K2' || 
        request.auth.token.email == 'isaacmargues03@gmail.com'
      );
    }

    // REGRA DE OURO: Admin tem acesso total a TUDO
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // REGRAS PARA USUÁRIOS COMUNS
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /accounts/{accountId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
        
        // Permite o bônus de indicação
        allow update: if request.auth != null && 
          request.resource.data.balance == resource.data.balance + 1;

        // Regra específica para a subcoleção de transações (Corrige o erro de permissão ao listar)
        match /depositTransactions/{docId} {
          allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
        }
      }

      match /investments/{invId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Tokens de resgate
    match /tokens_resgate/{tokenId} {
      allow read, write: if isAdmin();
      allow get: if request.auth != null;
      allow update: if request.auth != null && request.resource.data.usado == true;
    }

    // Sistema de Indicação
    match /referralCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /referrals/{referralId} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId);
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.referredId;
    }

    // Suporte para Collection Group (necessário para o Webhook e consultas globais)
    match /{path=**}/depositTransactions/{docId} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.userId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == request.resource.data.userId);
    }
  }
}