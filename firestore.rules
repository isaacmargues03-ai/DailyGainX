
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função para verificar se o usuário está logado
    function isSignedIn() {
      return request.auth != null;
    }

    // Função de Admin - Identifica você pelo UID ou E-mail
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'isaacmargues03@gmail.com' || 
        request.auth.uid == 'skTsvEKxywUKcBKPHzG9h7WkK7K2'
      );
    }

    // REGRA GLOBAL: Administrador tem acesso total a qualquer documento
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // SUPORTE PARA COLLECTION GROUP: Necessário para o painel de saques
    match /{path=**}/depositTransactions/{id} {
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Regras específicas para Usuários Comuns (Segurança Adicional)
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;

      match /accounts/{userAccountId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId;

        match /depositTransactions/{txId} {
          allow read, write: if isSignedIn() && request.auth.uid == userId;
        }
      }
    }

    match /tokens_resgate/{tokenId} {
      allow get: if isSignedIn();
      allow update: if isSignedIn(); 
    }

    match /referralCodes/{code} {
      allow get: if true;
      allow create: if isSignedIn();
    }

    match /referrals/{referralId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId);
      allow create: if isSignedIn();
    }
  }
}
