rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função central para identificar o administrador
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'skTsvEKxywUKcBKPHzG9h7WkK7K2' || 
        request.auth.token.email == 'isaacmargues03@gmail.com'
      );
    }

    // REGRA MESTRA: Administrador tem acesso total a qualquer documento em qualquer caminho
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Regras específicas para usuários comuns (segurança de dados próprios)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /accounts/{accountId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /depositTransactions/{txId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Regras para Resgate de Tokens (Abertas para verificação e uso)
    match /tokens_resgate/{tokenId} {
      allow get, update: if request.auth != null;
    }

    // Sistema de indicações
    match /referralCodes/{code} {
      allow get: if true;
      allow create: if request.auth != null;
    }

    match /referrals/{referralId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId);
      allow create: if request.auth != null;
    }
    
    // Suporte explícito para consultas de grupo (Collection Group)
    match /{path=**}/depositTransactions/{id} {
      allow read, list: if isAdmin();
    }
  }
}