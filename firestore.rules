
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FUNÇÃO MESTRE: Identifica o Administrador por UID ou Email
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'skTsvEKxywUKcBKPHzG9h7WkK7K2' || 
        request.auth.token.email == 'isaacmargues03@gmail.com'
      );
    }

    // REGRA DE OURO: Admin tem acesso total a TUDO de forma recursiva
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Suporte explícito para Collection Group
    match /{path=**}/depositTransactions/{docId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
    }

    // REGRAS PARA USUÁRIOS COMUNS
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /accounts/{accountId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
        
        // Permite que qualquer usuário autenticado incremente o saldo de outro em exatamente 1 USDT (Bônus de Indicação)
        allow update: if request.auth != null && 
          request.resource.data.balance == resource.data.balance + 1;

        match /depositTransactions/{txId} {
          allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
        }
      }

      match /investments/{invId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /tokens_resgate/{tokenId} {
      allow read, write: if isAdmin();
      allow get, update: if request.auth != null;
    }

    match /referralCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /referrals/{referralId} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId);
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.referredId;
    }
  }
}
