rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FUNÇÃO MESTRE: Identifica o Administrador por UID ou Email
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'skTsvEKxywUKcBKPHzG9h7WkK7K2' || 
        request.auth.token.email == 'isaacmargues03@gmail.com'
      );
    }

    // REGRA DE OURO: Administrador tem acesso TOTAL e IRRESTRITO a qualquer documento ou coleção
    // Esta regra deve vir primeiro para garantir que nenhuma regra posterior a limite
    match /{document=**} {
      allow read, write, list: if isAdmin();
    }

    // SUPORTE PARA CONSULTA DE GRUPO (COLLECTION GROUP)
    // Essencial para o Admin listar saques de todos os usuários
    match /{path=**}/depositTransactions/{docId} {
      allow read, list, write: if isAdmin();
    }

    // REGRAS PARA USUÁRIOS COMUNS (Segurança de dados próprios)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /accounts/{accountId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /depositTransactions/{txId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // TOKENS DE RESGATE
    match /tokens_resgate/{tokenId} {
      // Usuário logado pode ler (get) e atualizar (resgatar)
      allow get, update: if request.auth != null;
      // Admin tem controle total (já coberto pela regra mestre, mas reforçado aqui)
      allow read, write: if isAdmin();
    }

    // SISTEMA DE INDICAÇÕES
    match /referralCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /referrals/{referralId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId || isAdmin());
      allow create: if request.auth != null;
    }
  }
}