rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FUNÇÃO MESTRE: Identifica o Administrador por UID ou Email
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'skTsvEKxywUKcBKPHzG9h7WkK7K2' || 
        request.auth.token.email == 'isaacmargues03@gmail.com'
      );
    }

    // REGRA DE OURO: Admin tem acesso total a TUDO, incluindo Collection Groups e Raiz
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Suporte explícito para Collection Group (Necessário para a lista global de saques)
    match /{path=**}/depositTransactions/{docId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
    }

    // REGRAS PARA USUÁRIOS COMUNS
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /accounts/{accountId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /depositTransactions/{txId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    match /tokens_resgate/{tokenId} {
      allow read, write: if isAdmin();
      allow get, update: if request.auth != null;
    }

    match /referralCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /referrals/{referralId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId);
      allow create: if request.auth != null;
    }
  }
}