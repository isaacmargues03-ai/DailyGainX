
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'isaacmargues03@gmail.com';
    }

    match /tokens_resgate/{tokenId} {
      // Qualquer pessoa logada pode verificar e atualizar um token para resgate
      allow get: if isSignedIn();
      allow list, create: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.usado == false && 
          request.resource.data.usado == true
        )
      );
      allow delete: if false; 
    }

    match /referralCodes/{code} {
      allow get: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /referrals/{referralId} {
      // Participantes da indicação podem ler e atualizar o status
      allow get: if isSignedIn() && (request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId);
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); 
      allow delete: if false;
    }

    match /users/{userId} {
      // Perfis são legíveis por qualquer usuário logado (necessário para validar indicações)
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /accounts/{userAccountId} {
        // Regra flexível para permitir que o sistema de recompensas atualize saldos
        allow get: if isSignedIn();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isSignedIn(); 
        allow delete: if isAdmin();

        match /depositTransactions/{depositTransactionId} {
          allow get, list: if isOwner(userId) || isAdmin();
          allow create, update: if isOwner(userId) || isAdmin();
          allow delete: if isAdmin();
        }
      }

      match /investments/{investmentId} {
        allow get, list, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
