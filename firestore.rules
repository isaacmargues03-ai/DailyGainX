rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FUNÇÃO MESTRE: Identifica o Administrador por UID ou Email
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'skTsvEKxywUKcBKPHzG9h7WkK7K2' || 
        request.auth.token.email == 'isaacmargues03@gmail.com'
      );
    }

    // ACESSO TOTAL ADMINISTRATIVO: Permite qualquer operação em qualquer lugar do banco
    // O uso de {allPaths=**} é a forma mais robusta de garantir acesso recursivo
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // SUPORTE PARA CONSULTAS DE GRUPO (Collection Group)
    // Necessário para que o Admin liste saques de todos os usuários simultaneamente
    match /{path=**}/depositTransactions/{docId} {
      allow read, write: if isAdmin();
    }

    // REGRAS PARA USUÁRIOS COMUNS (Segurança de dados próprios)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /accounts/{accountId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /depositTransactions/{txId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // TOKENS DE RESGATE
    match /tokens_resgate/{tokenId} {
      // Usuário logado pode ler (get) e atualizar (resgatar)
      allow get, update: if request.auth != null;
    }

    // SISTEMA DE INDICAÇÕES
    match /referralCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /referrals/{referralId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId);
      allow create: if request.auth != null;
    }
  }
}