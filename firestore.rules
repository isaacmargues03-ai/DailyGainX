rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função para verificar se o usuário está logado
    function isSignedIn() {
      return request.auth != null;
    }

    // Função de Admin - Identifica você pelo UID ou E-mail
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'isaacmargues03@gmail.com' || 
        request.auth.uid == 'skTsvEKxywUKcBKPHzG9h7WkK7K2'
      );
    }

    // REGRA MESTRA: Administrador tem acesso total e irrestrito a TUDO
    // O uso de {document=**} permite que o Admin faça qualquer consulta, incluindo Collection Groups
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Regras para Usuários Comuns (Segurança para dados próprios)
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /accounts/{userAccountId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;

        match /depositTransactions/{txId} {
          allow read, write: if isSignedIn() && request.auth.uid == userId;
        }
      }
    }

    // Regras para Resgate de Tokens
    match /tokens_resgate/{tokenId} {
      allow get, update: if isSignedIn();
    }

    // Regras para Indicações
    match /referralCodes/{code} {
      allow get: if true;
      allow create: if isSignedIn();
    }

    match /referrals/{referralId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId);
      allow create: if isSignedIn();
    }
    
    // Suporte explícito para Collection Group de transações (Saques Globais Admin)
    match /{path=**}/depositTransactions/{id} {
      allow read, list: if isAdmin();
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}