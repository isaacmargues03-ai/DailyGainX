
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Função de Admin Reforçada com UID e Email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'isaacmargues03@gmail.com' || 
        request.auth.uid == 'skTsvEKxywUKcBKPHzG9h7WkK7K2'
      );
    }

    // Permissão Global para o Administrador
    // Isso garante que o admin nunca receba "Missing or insufficient permissions"
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Regras específicas para Usuários Comuns (Segurança)
    
    match /tokens_resgate/{tokenId} {
      allow get: if isSignedIn();
      // list/create/update/delete cobertos pela regra global de admin
      allow update: if isSignedIn() && resource.data.usado == false && request.resource.data.usado == true;
    }

    match /referralCodes/{code} {
      allow get: if true;
      allow create: if isSignedIn();
    }

    match /referrals/{referralId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId);
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      match /accounts/{userAccountId} {
        allow get: if isSignedIn();
        allow list, create: if isOwner(userId);
        allow update: if isSignedIn(); 

        match /depositTransactions/{depositTransactionId} {
          allow get, list, create, update: if isOwner(userId);
        }
      }

      match /investments/{investmentId} {
        allow get, list, create, update: if isOwner(userId);
      }
    }
    
    // Suporte para Collection Group queries (Saques de todos os usuários)
    match /{path=**}/depositTransactions/{depositTransactionId} {
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
