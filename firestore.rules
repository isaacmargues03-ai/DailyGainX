
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'isaacmargues03@gmail.com' || 
        request.auth.uid == 'skTsvEKxywUKcBKPHzG9h7WkK7K2'
      );
    }

    // Regra global para permitir que o administrador veja transações de qualquer lugar (collectionGroup)
    match /{path=**}/depositTransactions/{depositTransactionId} {
      allow read, list: if isAdmin() || isOwner(resource.data.userId);
    }

    match /tokens_resgate/{tokenId} {
      allow get: if isSignedIn();
      allow list, create: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.usado == false && 
          request.resource.data.usado == true
        )
      );
      allow delete: if isAdmin(); 
    }

    match /referralCodes/{code} {
      allow get: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() || isAdmin(); 
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /accounts/{userAccountId} {
        allow get: if isSignedIn();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isSignedIn(); 
        allow delete: if isAdmin();

        match /depositTransactions/{depositTransactionId} {
          allow get, list: if isOwner(userId) || isAdmin();
          allow create, update: if isOwner(userId) || isAdmin();
          allow delete: if isAdmin();
        }
      }

      match /investments/{investmentId} {
        allow get, list, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
