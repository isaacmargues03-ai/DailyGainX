rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função central para identificar o administrador com segurança máxima
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'skTsvEKxywUKcBKPHzG9h7WkK7K2' || 
        request.auth.token.email == 'isaacmargues03@gmail.com'
      );
    }

    // REGRA MESTRA: Administrador tem acesso total e irrestrito a qualquer documento ou coleção
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Regra específica para suporte a Collection Group Queries (Essencial para listar saques de todos)
    match /{path=**}/depositTransactions/{docId} {
      allow read, list: if isAdmin();
    }

    // Regras específicas para usuários comuns (segurança de dados próprios)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /accounts/{accountId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /depositTransactions/{txId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Regras para Resgate de Tokens
    match /tokens_resgate/{tokenId} {
      allow get, update: if request.auth != null;
      allow read, write: if isAdmin();
    }

    // Sistema de indicações
    match /referralCodes/{code} {
      allow get: if true;
      allow create, write: if request.auth != null;
    }

    match /referrals/{referralId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredId || isAdmin());
      allow create: if request.auth != null;
    }
  }
}