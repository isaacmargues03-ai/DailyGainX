
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile information within the DailyGainX platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "name": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "profilePictureUrl": {
          "type": "string",
          "format": "uri"
        },
        "referralCode": {
          "type": "string",
          "description": "Unique referral code."
        },
        "hasMadeFirstDeposit": {
          "type": "boolean"
        },
        "referralId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "referralCode",
        "hasMadeFirstDeposit"
      ]
    },
    "UserAccount": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserAccount",
      "type": "object",
      "description": "Financial balance for users.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "balance": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "balance",
        "currency"
      ]
    },
    "RedemptionToken": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RedemptionToken",
      "type": "object",
      "description": "Tokens for manual balance redemption.",
      "properties": {
        "token": {
          "type": "string"
        },
        "valor": {
          "type": "number"
        },
        "usado": {
          "type": "boolean"
        },
        "criadoEm": {
          "type": "object"
        },
        "transactionId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        },
        "usedBy": {
          "type": "string"
        }
      },
      "required": [
        "token",
        "valor",
        "usado"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          }
        }
      },
      {
        "path": "/users/{userId}/accounts/{userAccountId}",
        "definition": {
          "entityName": "UserAccount",
          "schema": {
            "$ref": "#/backend/entities/UserAccount"
          }
        }
      },
      {
        "path": "/tokens_resgate/{tokenId}",
        "definition": {
          "entityName": "RedemptionToken",
          "schema": {
            "$ref": "#/backend/entities/RedemptionToken"
          }
        }
      }
    ]
  }
}
